# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Clerk — Autenticación
# Obtener en: https://dashboard.clerk.com → tu app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk — Rutas (deben coincidir con las páginas creadas en /app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Groq — IA para moderación y resumen de comentarios
# Obtener en: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# M2M — Integración Etapa 3
# Secreto que esta app manda cuando llama a otras apps
FEEDBACK_SERVICE_SECRET=
# Secretos que otras apps mandan cuando llaman a esta app
DRIVER_SERVICE_SECRET=
RIDER_SERVICE_SECRET=
CONTROL_PLANE_SECRET=
ANALYTICS_DASHBOARD_SECRET=
# URLs de las otras apps (sin barra al final)
DRIVER_APP_URL=https://tu-driver-app.vercel.app
RIDER_APP_URL=https://tu-rider-app.vercel.app
