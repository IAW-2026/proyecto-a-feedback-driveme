# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Clerk — Autenticación
# Obtener en: https://dashboard.clerk.com → tu app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk — Rutas (deben coincidir con las páginas creadas en /app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Groq — IA para moderación y resumen de comentarios
# Obtener en: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# M2M — Clave compartida con las otras apps del sistema (para la integración en Etapa 3)
# Generar con: openssl rand -hex 32
INTERNAL_API_KEY=
